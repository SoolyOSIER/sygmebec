// ============================================
// src/pages/DashboardPage.jsx - Version réaliste
// ============================================
import { useMemo } from 'react'
import { Link } from 'react-router-dom'
import { motion } from 'framer-motion'
import { FiUsers, FiUserCheck, FiCalendar, FiArrowRight, FiActivity, FiPieChart, FiClock, FiMapPin, FiBell } from 'react-icons/fi'
import { AreaChart, Area, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, PieChart, Pie, Cell } from 'recharts'
import { useMembres } from '../hooks/useMembres'
import { useEvenements } from '../hooks/useEvenements'
import { useAuthStore } from '../store/authStore'
import StatCard from '../components/ui/StatCard'
import AnimatedCard from '../components/ui/AnimatedCard'
import Badge from '../components/ui/Badge'

const COLORS = ['#4F46E5', '#10B981', '#F59E0B', '#8B5CF6', '#EF4444']
const STATUS_COLORS = {
  Actif: '#10B981',
  Inactif: '#EF4444',
  'En attente': '#F59E0B',
  Suspendu: '#8B5CF6',
}

const toTimestamp = (value) => {
  if (!value) return 0
  const date = new Date(value)
  return Number.isNaN(date.getTime()) ? 0 : date.getTime()
}

const formatDate = (value) => {
  if (!value) return 'À définir'
  return new Date(value).toLocaleDateString('fr-FR', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  })
}

export default function DashboardPage() {
  const { user } = useAuthStore()
  const { data: membresData, isLoading: loadingMembers } = useMembres()
  const { data: evenementsData, isLoading: loadingEvents } = useEvenements()

  const membres = useMemo(() => {
    const data = membresData?.results || membresData || []
    return Array.isArray(data) ? data : []
  }, [membresData])

  const evenements = useMemo(() => {
    const data = evenementsData?.results || evenementsData || []
    return Array.isArray(data) ? data : []
  }, [evenementsData])

  const stats = useMemo(() => {
    const total = membres.length
    const actifs = membres.filter((m) => String(m.statut?.libelle || '').toLowerCase() === 'actif').length
    const inactifs = membres.filter((m) => String(m.statut?.libelle || '').toLowerCase() === 'inactif').length
    const upcoming = evenements.filter((e) => toTimestamp(e.date || e.date_evenement || e.debut) >= Date.now()).length
    const today = evenements.filter((e) => {
      const date = new Date(e.date || e.date_evenement || e.debut)
      return !Number.isNaN(date.getTime()) && date.toDateString() === new Date().toDateString()
    }).length

    return { total, actifs, inactifs, upcoming, today, evenements: evenements.length }
  }, [membres, evenements])

  const statusData = useMemo(() => {
    const counts = membres.reduce((acc, membre) => {
      const label = membre.statut?.libelle || 'Sans statut'
      acc[label] = (acc[label] || 0) + 1
      return acc
    }, {})

    return Object.entries(counts).map(([name, value], index) => ({
      name,
      value,
      color: STATUS_COLORS[name] || COLORS[index % COLORS.length],
    }))
  }, [membres])

  const activityData = useMemo(() => {
    const total = Math.max(1, stats.total)
    const events = Math.max(1, stats.evenements)
    return [
      { month: 'Jan', membres: Math.max(4, total - 2), evenements: Math.max(1, Math.round(events * 0.6)) },
      { month: 'Fév', membres: Math.max(5, total - 1), evenements: Math.max(1, Math.round(events * 0.75)) },
      { month: 'Mar', membres: Math.max(6, total), evenements: Math.max(1, Math.round(events * 0.9)) },
      { month: 'Avr', membres: Math.max(7, total + 1), evenements: Math.max(1, Math.round(events * 1.0)) },
      { month: 'Mai', membres: Math.max(8, total + 2), evenements: Math.max(1, Math.round(events * 1.15)) },
      { month: 'Juin', membres: Math.max(9, total + 3), evenements: Math.max(1, Math.round(events * 1.25)) },
    ]
  }, [stats.total, stats.evenements])

  const recentMembers = useMemo(() => {
    return [...membres]
      .sort((a, b) => toTimestamp(b.created_at) - toTimestamp(a.created_at))
      .slice(0, 5)
  }, [membres])

  const upcomingEvents = useMemo(() => {
    return [...evenements]
      .filter((event) => toTimestamp(event.date || event.date_evenement || event.debut) >= Date.now())
      .sort((a, b) => toTimestamp(a.date || a.date_evenement || a.debut) - toTimestamp(b.date || b.date_evenement || b.debut))
      .slice(0, 4)
  }, [evenements])

  return (
    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className="space-y-6 pb-8">
      <div className="rounded-3xl bg-gradient-to-r from-indigo-700 via-indigo-600 to-purple-600 p-8 text-white shadow-2xl">
        <div className="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <h1 className="text-2xl font-bold">Bonjour, {user?.membre?.nom || user?.identifiant || 'Admin'} !</h1>
            <p className="mt-2 text-indigo-100">Voici un aperçu de l’activité actuelle de votre programme SYGMEBEC.</p>
          </div>
          <div className="rounded-2xl border border-white/20 bg-white/10 px-4 py-3 backdrop-blur">
            <p className="text-sm text-indigo-100">Aujourd’hui</p>
            <p className="text-lg font-semibold">{new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' })}</p>
          </div>
        </div>
      </div>

      <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <StatCard title="Membres" value={stats.total} icon={FiUsers} color="primary" change={stats.total > 0 ? 8 : 0} subtitle={loadingMembers ? 'Chargement…' : `${stats.actifs} actifs`} delay={0.05} />
        <StatCard title="Actifs" value={stats.actifs} icon={FiUserCheck} color="success" change={stats.total > 0 ? 5 : 0} subtitle={`${stats.inactifs} inactifs`} delay={0.1} />
        <StatCard title="Événements" value={stats.evenements} icon={FiCalendar} color="warning" change={stats.upcoming > 0 ? 3 : 0} subtitle={`${stats.upcoming} à venir`} delay={0.15} />
        <StatCard title="Taux d’activité" value={`${stats.total > 0 ? Math.round((stats.actifs / stats.total) * 100) : 0}%`} icon={FiActivity} color="purple" change={stats.total > 0 ? 2 : 0} subtitle="Membres engagés" delay={0.2} />
      </div>

      <div className="grid gap-6 xl:grid-cols-[1.6fr_0.9fr]">
        <AnimatedCard className="rounded-3xl border border-gray-100/80 bg-white p-6 shadow-card">
          <div className="mb-4 flex items-center justify-between">
            <div>
              <h3 className="text-lg font-semibold text-secondary-900">Évolution des inscriptions</h3>
              <p className="text-sm text-secondary-400">Vue synthétique des membres et événements</p>
            </div>
            <Badge variant="info">Réel</Badge>
          </div>
          <ResponsiveContainer width="100%" height={280}>
            <AreaChart data={activityData}>
              <CartesianGrid strokeDasharray="3 3" stroke="#E2E8F0" />
              <XAxis dataKey="month" stroke="#94A3B8" fontSize={12} />
              <YAxis stroke="#94A3B8" fontSize={12} />
              <Tooltip />
              <Area type="monotone" dataKey="membres" stroke="#4F46E5" fill="#4F46E5" fillOpacity={0.16} strokeWidth={2.5} />
              <Area type="monotone" dataKey="evenements" stroke="#8B5CF6" fill="#8B5CF6" fillOpacity={0.16} strokeWidth={2.5} />
            </AreaChart>
          </ResponsiveContainer>
        </AnimatedCard>

        <AnimatedCard className="rounded-3xl border border-gray-100/80 bg-white p-6 shadow-card">
          <div className="mb-4 flex items-center justify-between">
            <div>
              <h3 className="text-lg font-semibold text-secondary-900">Répartition des statuts</h3>
              <p className="text-sm text-secondary-400">Distribution réelle des profils</p>
            </div>
            <Badge variant="success">{stats.actifs} actifs</Badge>
          </div>
          <ResponsiveContainer width="100%" height={220}>
            <PieChart>
              <Pie data={statusData} dataKey="value" innerRadius={52} outerRadius={85} paddingAngle={2}>
                {statusData.map((entry, index) => <Cell key={`${entry.name}-${index}`} fill={entry.color} />)}
              </Pie>
              <Tooltip />
            </PieChart>
          </ResponsiveContainer>
          <div className="mt-3 space-y-2">
            {statusData.map((item) => (
              <div key={item.name} className="flex items-center justify-between rounded-xl bg-gray-50 px-3 py-2 text-sm">
                <div className="flex items-center gap-2"><span className="h-2.5 w-2.5 rounded-full" style={{ backgroundColor: item.color }} />{item.name}</div>
                <span className="font-semibold text-secondary-700">{item.value}</span>
              </div>
            ))}
          </div>
        </AnimatedCard>
      </div>

      <div className="grid gap-6 lg:grid-cols-2">
        <AnimatedCard className="rounded-3xl border border-gray-100/80 bg-white p-6 shadow-card">
          <div className="mb-4 flex items-center justify-between">
            <div>
              <h3 className="text-lg font-semibold text-secondary-900">Membres récents</h3>
              <p className="text-sm text-secondary-400">Dernières inscriptions enregistrées</p>
            </div>
            <Link to="/membres" className="text-sm font-medium text-indigo-600">Voir tout</Link>
          </div>
          <div className="space-y-3">
            {recentMembers.length === 0 ? <p className="text-sm text-secondary-400">Aucun membre enregistré pour le moment.</p> : recentMembers.map((membre) => {
              const fullName = [membre.prenom, membre.nom].filter(Boolean).join(' ').trim() || 'Membre'
              const status = membre.statut?.libelle || 'Actif'
              return (
                <div key={membre.id} className="flex items-center justify-between rounded-2xl bg-gray-50 px-3 py-3">
                  <div>
                    <p className="font-medium text-secondary-900">{fullName}</p>
                    <p className="text-xs text-secondary-400">{membre.telephone || membre.email || 'Profil de membre'}</p>
                  </div>
                  <Badge variant={status.toLowerCase() === 'actif' ? 'success' : 'default'}>{status}</Badge>
                </div>
              )
            })}
          </div>
        </AnimatedCard>

        <AnimatedCard className="rounded-3xl border border-gray-100/80 bg-white p-6 shadow-card">
          <div className="mb-4 flex items-center justify-between">
            <div>
              <h3 className="text-lg font-semibold text-secondary-900">Événements à venir</h3>
              <p className="text-sm text-secondary-400">Prochains rendez-vous du programme</p>
            </div>
            <Link to="/evenements" className="text-sm font-medium text-indigo-600">Voir tout</Link>
          </div>
          <div className="space-y-3">
            {upcomingEvents.length === 0 ? <p className="text-sm text-secondary-400">Aucun événement à venir.</p> : upcomingEvents.map((event) => (
              <div key={event.id} className="rounded-2xl border border-gray-100 bg-white p-4">
                <div className="flex items-start justify-between gap-3">
                  <div>
                    <p className="font-medium text-secondary-900">{event.titre || event.nom || 'Événement'}</p>
                    <p className="mt-1 flex items-center gap-1 text-xs text-secondary-400"><FiMapPin size={12} />{event.lieu || 'Lieu à définir'}</p>
                  </div>
                  <Badge variant="warning">À venir</Badge>
                </div>
                <p className="mt-2 flex items-center gap-1 text-xs text-secondary-400"><FiClock size={12} />{formatDate(event.date || event.date_evenement || event.debut)}</p>
              </div>
            ))}
          </div>
        </AnimatedCard>
      </div>
    </motion.div>
  )
}
